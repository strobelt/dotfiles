configuration {
    dpi: 72;
    modes: [combi];
    combi-modes: [drun, window];
    font: "CaskaydiaCode 12";
    show-icons: true;
    icon-theme: "Papirus";
    combi-hide-mode-prefix: true;
}

@import "colors.rasi"

inputbar {
    padding:    1px;
    spacing:    0px;
    text-color: var(normal-foreground);
    children:   [ "entry","num-filtered-rows","textbox-num-sep","num-rows","case-indicator" ];
}

#window {
    width: 80%;
    height: 60%;
    background-color: @background-solid;
    padding: 10px;
}

#mainbox {
    border:  0;
    padding: 0;
    children: [inputbar, listview];
    background-color: @background-solid;
}

#listview {
    columns: 5;
    layout: vertical;
    background-color: transparent;
}

element {
    margin: 8px;
    padding: 10px;
    border-radius: 8px;
    orientation: horizontal;
}

element-icon {
    size: 3em;
    margin: 1em;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

#element.normal.normal, element.alternate.normal {
    background-color: @unselected-background;
    text-color:       @foreground;
    size: 0px;
}

#element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

#element-text.normal, element-icon.normal {
    background-color: transparent;
}

#element.selected.normal {
    background-image: @selected-background-gradient;
    // background-color: @selected-background;
    text-color:       @selected-foreground;
    border-color: #d07ef2;
}

#mode-switcher {
    border:       0px 0px 0px ;
    border-color: @separatorcolor;
}

#button {
    spacing:    0;
    text-color: @foreground;
}

#button.selected {
    background-color: @selected-background;
    text-color:       @selected-foreground;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
